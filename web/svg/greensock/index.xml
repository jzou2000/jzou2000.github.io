    <item>
      <title>Moving Ball</title>
      <link>/web/svg/greensock/moving-ball/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>/web/svg/greensock/moving-ball/</guid>
      <description>&lt;script src=&#39;https://unpkg.co/gsap@3/dist/gsap.min.js&#39;&gt;&lt;/script&gt;&#xA;&lt;script src=&#39;https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.5/MotionPathPlugin.min.js&#39;&gt;&lt;/script&gt;&#xA;&lt;style type=&#39;text/css&#39;&gt;&#xA;h1 { color: green; }&#xA;svg {&#xA;  background: green;&#xA;}&#xA;svg rect {&#xA;  stroke-width: 3;&#xA;  fill: lightgreen;&#xA;}&#xA;.s {&#xA;    stroke: blue;&#xA;    stroke-width: 3;&#xA;    fill: none;&#xA;}&#xA;.sp {&#xA;    stroke: gray;&#xA;    fill: none;&#xA;}&#xA;.ob { stroke: none; }&#xA;.ot {&#xA;  fill: yellow;&#xA;/*  font-size: 30px;*/&#xA;}&#xA;.obj {&#xA;  opacity: 85%;&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;p&gt;Click the button &lt;button onclick=&#39;go()&#39;&gt;Go!&lt;/button&gt;, the ball moves along the path back-and-forth twice.&lt;/p&gt;&#xA;&lt;svg viewbox=&#39;0 0 400 300&#39; width=&#39;400&#39; height=&#39;300&#39;&gt;&#xA;    &lt;rect x=&#39;50&#39; y=&#39;20&#39; width=&#39;150&#39; height=&#39;80&#39;/&gt;&#xA;    &lt;circle class=&#39;s&#39; cx=&#39;40&#39; cy=&#39;40&#39; r=&#39;30&#39;/&gt;&#xA;    &lt;circle class=&#39;s&#39; cx=&#39;340&#39; cy=&#39;40&#39; r=&#39;30&#39;/&gt;&#xA;    &lt;path id=&#39;p1&#39; class=&#39;sp&#39; d=&#39;M40 40 Q 190 100 340 40&#39;/&gt;&#xA;    &lt;g id=&#39;g1&#39; class=&#39;obj&#39;&gt;&#xA;        &lt;circle classs=&#39;ob&#39; cx=&#39;40&#39; cy=&#39;40&#39; r=&#39;30&#39; fill=&#39;red&#39; stroke=&#39;black&#39;/&gt;&#xA;        &lt;text class=&#39;ot&#39; x=&#39;40&#39; y=&#39;40&#39; text-anchor=&#39;middle&#39; dominant-baseline=&#34;middle&#34;&gt;305&lt;/text&gt;&#xA;    &lt;/g&gt;&#xA;&lt;/svg&gt;&#xA;&lt;script&gt;&#xA;gsap.registerPlugin(MotionPathPlugin);&#xA;&#xA;function go() {&#xA;gsap.to(&#39;#g1&#39;, {&#xA;    motionPath: {&#xA;        path: &#39;m0 0 Q 150 60 300 0&#39;,&#xA;    },&#xA;    x: 300,&#xA;    yoyo: true,&#xA;    duration: 1,&#xA;    repeatDelay: .5,&#xA;    repeat: 3,&#xA;    ease: &#39;back.inOut(1.7)&#39;,&#xA;})&#xA;}&#xA;&lt;/script&gt;</description>
    </item>
    <item>
      <title>Trace The Mouse</title>
      <link>/web/svg/greensock/trace-mouse/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>/web/svg/greensock/trace-mouse/</guid>
      <description>&lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.3/gsap.min.js&#34;&gt;&lt;/script&gt;&#xA;&lt;style&gt;&#xA;    .svg {&#xA;        background-color: papayawhip;&#xA;    }&#xA;&lt;/style&gt;&#xA;&lt;div id=&#39;app&#39;&gt;&#xA;&lt;p&gt;Move the mouse around and click, the rect object will follow your track.&lt;/p&gt;&#xA;&lt;svg viewbox=&#39;0 0 400 300&#39; width=&#39;400&#39; height=&#39;300&#39; class=&#39;svg&#39;&gt;&#xA;    &lt;g @mousemove=&#39;svgMouseMove&#39; @click=&#39;onTrace&#39;&gt;&#xA;    &lt;rect x=&#39;0&#39; y=&#39;0&#39; width=&#39;400&#39; height=&#39;300&#39; fill=&#39;papayawhip&#39; ref=&#39;panel&#39; /&gt;&#xA;    &lt;rect id=&#39;car&#39;&#xA;        x=&#39;0&#39; y=&#39;0&#39;&#xA;        width=&#39;100&#39; height=&#39;50&#39;&#xA;        fill=&#39;steelblue&#39;&#xA;        rx=&#39;8&#39;&#xA;        ref=&#39;car&#39;&#xA;    /&gt;&#xA;    &lt;text x=&#39;30&#39; y=&#39;250&#39; stroke=&#39;red&#39;&gt;{{message}}&lt;/text&gt;&#xA;    &lt;text x=&#39;130&#39; y=&#39;250&#39;&gt;({{x}}, {{y}}) {{msg}}&lt;/text&gt;&#xA;    &lt;/g&gt;&#xA;&lt;/svg&gt;&#xA;&lt;/div&gt;&#xA;&lt;script&gt;&#xA;/*&#xA;*/&#xA;&#xA;var app = new Vue({&#xA;    el: &#39;#app&#39;,&#xA;    data: {&#xA;        message: &#39;I love svg&#39;,&#xA;        x: 0,&#xA;        y: 0,&#xA;        msg: &#39;&#39;,&#xA;        trace: [],&#xA;    },&#xA;    methods: {&#xA;        onTrace(event) {&#xA;            let tl = gsap.timeline()&#xA;            let car = this.$refs.car&#xA;            let ts = this.trace&#xA;            let n = ts.length&#xA;            // for (let v of ts) {&#xA;            //     tl.to(car, {x: v.x, y: v.y, duration: 0.01})&#xA;            // }&#xA;            let s = 10&#xA;            for (let i = 1; i &lt;= s; i++) {&#xA;                let b = parseInt(n / s * i)&#xA;                if (b == n) b = n - 1&#xA;                tl.to(car, {x: ts[b].x, y: ts[b].y, duration: 0.05})&#xA;            }&#xA;            this.trace = []&#xA;        },&#xA;        svgMouseMove(event) {&#xA;            this.x = event.offsetX&#xA;            this.y = event.offsetY&#xA;            this.trace.push({x: this.x, y: this.y})&#xA;        }&#xA;    }&#xA;})&#xA;&#xA;&lt;/script&gt;</description>
    </item>
