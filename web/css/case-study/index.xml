    <item>
      <title>max-width</title>
      <link>/web/css/case-study/max-width/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>/web/css/case-study/max-width/</guid>
      <description>&lt;p&gt;conclusion: max-width overrides width&lt;/p&gt;&#xA;&lt;style type=&#39;text/css&#39;&gt;&#xA;.frame {&#xA;    margin-top: 32px;&#xA;    background: gray;&#xA;    width: 500px;&#xA;    height: 200px;&#xA;    overflow: hidden;&#xA;    border-radius: 16px;&#xA;}&#xA;.frame img {&#xA;    display: block;&#xA;    margin: auto;&#xA;}&#xA;.panel {&#xA;    width: 400px;&#xA;}&#xA;.filled {&#xA;    width: 100%;&#xA;    height: 100%;&#xA;}&#xA;.max {&#xA;    max-width: 150px;&#xA;}&#xA;.m {&#xA;    width: 60%;&#xA;}&#xA;.fixed {&#xA;    width: 200px;&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;p&gt;default&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39;&gt;&#xA;&lt;/div&gt;&#xA;&lt;p&gt;fill&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39; class=&#39;filled&#39;&gt;&#xA;&lt;/div&gt;&#xA;&lt;p&gt;width=m 60%&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39; class=&#39;m&#39;&gt;&#xA;&lt;/div&gt;&#xA;&lt;p&gt;width=m 60% max&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39; class=&#39;m max&#39;&gt;&#xA;&lt;/div&gt;&#xA;&lt;p&gt;width=fixed 200&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39; class=&#39;fixed&#39;&gt;&#xA;&lt;/div&gt;&#xA;&lt;p&gt;width=fixed 200 max&lt;/p&gt;&#xA;&lt;div class=&#39;frame&#39;&gt;&#xA;  &lt;img src=&#39;../sample.svg&#39; class=&#39;fixed max&#39;&gt;&#xA;&lt;/div&gt;</description>
