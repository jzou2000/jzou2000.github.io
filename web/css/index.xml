    <item>
      <title>position</title>
      <link>/web/css/position/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>/web/css/position/</guid>
      <description>&lt;style type=&#34;text/css&#34;&gt;&#xA;.box {&#xA;    border: thin solid black;&#xA;    margin: 4px;&#xA;    padding: 12px;&#xA;    border-radius: 8px;&#xA;}&#xA;.blue {&#xA;    background-color: lightblue;&#xA;}&#xA;.green {&#xA;    background-color: lightgreen;&#xA;}&#xA;.red {&#xA;    background-color: pink;&#xA;}&#xA;.yellow {&#xA;    background-color: lightyellow;&#xA;}&#xA;.container {&#xA;    position: relative;&#xA;    overflow: auto;&#xA;    background-color: #eee;&#xA;    border-radius: 8px;&#xA;}&#xA;.big {&#xA;    height: 5cm;&#xA;}&#xA;.h-2 {&#xA;    height: 2cm;&#xA;}&#xA;.w-2 {&#xA;    width: 2cm;&#xA;}&#xA;.c-abs div {&#xA;    position: absolute;&#xA;    height: 2cm;&#xA;    width: 2cm;&#xA;}&#xA;.c-sticky div {&#xA;    position: sticky;&#xA;    height: 2cm;&#xA;    width: 3cm;&#xA;}&#xA;.p-0 {&#xA;    left: 0px;&#xA;    top: 0px;&#xA;}&#xA;.p-1 {&#xA;    left: 100px;&#xA;    top: 30px;&#xA;}&#xA;.p-2 {&#xA;    left: 200px;&#xA;    top: 80px;&#xA;}&#xA;.sticky-2 {&#xA;    position: sticky;&#xA;    top: 1.0cm;&#xA;}&#xA;.abs {&#xA;    position: absolute;&#xA;    top: 0;&#xA;}&#xA;&lt;/style&gt;&#xA;&lt;div class=&#39;box container c-abs big&#39;&gt;&#xA;  &lt;h2&gt;default is absolute&lt;/h2&gt;&#xA;  This is a container for children that have position=absolute by default.&#xA;  &lt;p&gt;more text&lt;/p&gt;</description>
    </item>
