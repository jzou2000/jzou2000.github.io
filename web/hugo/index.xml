    <item>
      <title>Variables</title>
      <link>/web/hugo/vars/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>/web/hugo/vars/</guid>
      <description>&lt;h2 id=&#34;page-variables&#34;&gt;Page Variables&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th style=&#34;text-align: left&#34;&gt;variable&lt;/th&gt;&#xA;          &lt;th style=&#34;text-align: left&#34;&gt;Description&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.Ancestors&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;a stack of ancestors, starts from root &lt;code&gt;/&lt;/code&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.CurrentSection&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;page: the section it belongs to, section: itself&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.FirstSection&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;the section that directly below root, i.e. the 2nd item in ancestors stack&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.Parent&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;parent the current page/section belongs to&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.Pages&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;one level below this, regular pages and sections&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.RegularPages&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;regular pages directly below to this section&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.Sections&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;sections directly below to this section&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;.Permalink&lt;/td&gt;&#xA;          &lt;td style=&#34;text-align: left&#34;&gt;link of this page/section&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h3 id=&#34;recipes&#34;&gt;recipes&lt;/h3&gt;&#xA;&lt;ul&gt;&#xA;&lt;li&gt;check section is toplevel&lt;br&gt;&#xA;&lt;code&gt;eq 1 .Ancestors.Len&lt;/code&gt; or&lt;br&gt;&#xA;&lt;code&gt;eq .FirstSection .CurrentSection&lt;/code&gt;&lt;/li&gt;&#xA;&lt;/ul&gt;</description>
    </item>
